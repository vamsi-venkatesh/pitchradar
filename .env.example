# Optional: enables DeepSeek synthesis over PitchRadar's live, tenant-scoped RAG context.
# Explicit writes and approval-gated actions remain deterministic safety-layer commands.
PITCHRADAR_LLM_API_KEY=
PITCHRADAR_LLM_BASE_URL=https://api.deepseek.com
PITCHRADAR_LLM_MODEL=deepseek-v4-flash
PITCHRADAR_LLM_REASONING_MODEL=deepseek-v4-pro

# Isolated n8n readiness intake. Delivery remains disabled until client channel details are approved.
PITCHRADAR_N8N_WEBHOOK_URL=
PITCHRADAR_N8N_WEBHOOK_KEY=

# Optional: enables broad public-web search. Direct official-page rechecks work without it.
BRAVE_SEARCH_API_KEY=
# Free/self-hosted alternative, for example https://search.example.com
SEARXNG_BASE_URL=

# Production server
PORT=4182
# Where the weekly generator writes and the product's Reports view reads.
PITCHRADAR_REPORTS_DIR=reports
# PostgreSQL is the canonical PitchRadar operating database.
# Example local socket connection: postgresql:///pitchradar_dev
PITCHRADAR_DATABASE_URL=
PITCHRADAR_DATABASE_POOL_SIZE=6

# Private owner threshold. Production must use "required".
# Generate the password hash with: npm run auth:hash
PITCHRADAR_AUTH_MODE=disabled
PITCHRADAR_OWNER_PASSWORD_HASH=
# Generate at least 32 random bytes, for example: openssl rand -base64 48
PITCHRADAR_SESSION_SECRET=
# Set true only when the product is served through HTTPS.
PITCHRADAR_COOKIE_SECURE=false
# Default: 12 hours.
PITCHRADAR_SESSION_TTL_SECONDS=43200
# Enable only when the app is private behind Cloudflare and its trusted reverse proxy.
PITCHRADAR_TRUST_CLOUDFLARE_IP=false
