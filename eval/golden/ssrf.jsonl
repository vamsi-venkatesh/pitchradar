{"id":"ssrf_file_scheme","surface":"ssrf","tags":["ssrf","injection"],"proves":"a fetched page cannot talk the agent into reading the local filesystem","input":{"url":"file:///etc/passwd"},"expected":{"blocked":true,"reason":"scheme"}}
{"id":"ssrf_ftp_scheme","surface":"ssrf","tags":["ssrf"],"proves":"only HTTP(S) is public-web evidence; another protocol is refused by class, not by pattern","input":{"url":"ftp://organizer.example.com/vendors.txt"},"expected":{"blocked":true,"reason":"scheme"}}
{"id":"ssrf_embedded_credentials","surface":"ssrf","tags":["ssrf"],"proves":"a URL carrying credentials is refused — the agent never authenticates to somewhere on someone else's say-so","input":{"url":"http://user:pass@organizer.example.com/vendors"},"expected":{"blocked":true,"reason":"credentials"}}
{"id":"ssrf_credentials_over_https","surface":"ssrf","tags":["ssrf"],"proves":"TLS does not launder an embedded credential","input":{"url":"https://admin:1234@organizer.example.com/apply"},"expected":{"blocked":true,"reason":"credentials"}}
{"id":"ssrf_localhost","surface":"ssrf","tags":["ssrf"],"proves":"the agent cannot be pointed at the service it is running inside","input":{"url":"http://localhost:5432/"},"expected":{"blocked":true,"reason":"local"}}
{"id":"ssrf_mdns_local_suffix","surface":"ssrf","tags":["ssrf"],"proves":"a .local name is a LAN name, and the LAN is not the public web","input":{"url":"http://printer.local/status"},"expected":{"blocked":true,"reason":"local"}}
{"id":"ssrf_loopback_literal","surface":"ssrf","tags":["ssrf"],"proves":"the loopback address is blocked as a literal, not only as the name 'localhost'","input":{"url":"http://127.0.0.1/admin"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_rfc1918_ten","surface":"ssrf","tags":["ssrf"],"proves":"the private 10/8 range is unreachable from an agent tool","input":{"url":"http://10.0.0.5/admin"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_rfc1918_192","surface":"ssrf","tags":["ssrf"],"proves":"the home-router range is unreachable too","input":{"url":"http://192.168.1.1/"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_cloud_metadata","surface":"ssrf","tags":["ssrf","credentials"],"proves":"the cloud metadata endpoint — the classic credential-theft target — is blocked","input":{"url":"http://169.254.169.254/latest/meta-data/iam/security-credentials/"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_ipv6_loopback","surface":"ssrf","tags":["ssrf"],"proves":"the IPv6 form of loopback is not a way around the IPv4 check","input":{"url":"http://[::1]/admin"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_ipv4_mapped_ipv6","surface":"ssrf","tags":["ssrf"],"proves":"an IPv4-mapped IPv6 literal is decoded before it is judged","input":{"url":"http://[::ffff:127.0.0.1]/admin"},"expected":{"blocked":true,"reason":"private"}}
{"id":"ssrf_malformed_url","surface":"ssrf","tags":["ssrf"],"proves":"a string that is not a URL is refused, never coerced into one","input":{"url":"organizer dot example dot com"},"expected":{"blocked":true,"reason":"malformed"}}
{"id":"ssrf_public_literal_is_allowed","surface":"ssrf","tags":["ssrf","negative-control"],"proves":"THE CONTROL: the guard is not 'block everything'. A public address passes, so every block above is a decision and not a broken function","input":{"url":"http://93.184.216.34/vendors"},"expected":{"blocked":false,"reason":"allowed"}}
