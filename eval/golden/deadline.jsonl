// deadline — the sentence the owner reads, and the alert pass behind it.
// Every case supplies its own `now`; nothing here reads the wall clock (see surfaces.mts).
{"id":"deadline_label_published_days","surface":"deadline","tags":["deadline","label"],"proves":"a published future deadline is printed with an exact remaining-day count","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"published","deadline":"2026-10-18"},"expected":{"label":"Deadline 18 Oct 2026 — 13 days"}}
{"id":"deadline_label_published_one_day","surface":"deadline","tags":["deadline","label"],"proves":"the last day before a deadline says 'day', not 'days'","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"published","deadline":"2026-10-06"},"expected":{"label":"Deadline 06 Oct 2026 — 1 day"}}
{"id":"deadline_label_published_today","surface":"deadline","tags":["deadline","label"],"proves":"a deadline falling today is 'today', never '0 days' and never 'passed'","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"published","deadline":"2026-10-05"},"expected":{"label":"Deadline 05 Oct 2026 — today"}}
{"id":"deadline_label_passed","surface":"deadline","tags":["deadline","label"],"proves":"a deadline in the past is reported as passed, with no countdown","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"published","deadline":"2026-10-04"},"expected":{"label":"Deadline passed"}}
{"id":"deadline_label_not_found","surface":"deadline","tags":["deadline","label","honesty"],"proves":"'we have not found a deadline' stays a different sentence from 'there is no deadline' — the conflation migration 012 ended","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"not_found"},"expected":{"label":"No deadline published — not yet found"}}
{"id":"deadline_label_none_rolling","surface":"deadline","tags":["deadline","label","honesty"],"proves":"a rolling application route says so explicitly instead of inventing a date","input":{"mode":"label","now":"2026-10-05T09:00:00.000Z","evidence":"none_rolling"},"expected":{"label":"Rolling applications — no deadline exists"}}
{"id":"deadline_monitor_threshold_crossings","surface":"deadline","tags":["deadline","monitor"],"proves":"each published deadline earns one alert per threshold it has already crossed — no more, no fewer","input":{"mode":"monitor","now":"2026-10-05T09:00:00.000Z","dueWindows":4,"windows":[{"eventId":"event-30","deadline":"2026-11-04T12:00:00.000Z"},{"eventId":"event-14","deadline":"2026-10-19T12:00:00.000Z"},{"eventId":"event-07","deadline":"2026-10-12T12:00:00.000Z"},{"eventId":"event-02","deadline":"2026-10-07T12:00:00.000Z"}]},"expected":{"dueWindows":4,"alertsCreated":10,"alertsByThreshold":{"30":4,"14":3,"7":2,"2":1},"deadlinePassedCount":0,"thresholds":[30,14,7,2],"secondPassAlertsCreated":null}}
{"id":"deadline_monitor_idempotent_second_pass","surface":"deadline","tags":["deadline","monitor","idempotence"],"proves":"running the pass twice creates nothing the second time — the cycle can run it every day without spamming the owner","input":{"mode":"monitor","now":"2026-10-05T09:00:00.000Z","secondPass":true,"windows":[{"eventId":"event-07","deadline":"2026-10-12T12:00:00.000Z"}]},"expected":{"alertsCreated":3,"alertsByThreshold":{"30":1,"14":1,"7":1},"secondPassAlertsCreated":0}}
{"id":"deadline_monitor_passed_is_counted_not_alerted","surface":"deadline","tags":["deadline","monitor"],"proves":"a deadline already gone is counted as passed and generates no alert — nobody is told to hurry for a closed window","input":{"mode":"monitor","now":"2026-10-05T09:00:00.000Z","dueWindows":2,"windows":[{"eventId":"event-gone","deadline":"2026-10-01T12:00:00.000Z"}]},"expected":{"dueWindows":2,"alertsCreated":0,"alertsByThreshold":{},"deadlinePassedCount":1}}
{"id":"deadline_monitor_custom_thresholds","surface":"deadline","tags":["deadline","monitor"],"proves":"a configured threshold list is the one used, not the default","input":{"mode":"monitor","now":"2026-10-05T09:00:00.000Z","thresholds":[21,3],"windows":[{"eventId":"event-14","deadline":"2026-10-19T12:00:00.000Z"}]},"expected":{"alertsCreated":1,"alertsByThreshold":{"21":1},"thresholds":[21,3],"deadlinePassedCount":0}}
